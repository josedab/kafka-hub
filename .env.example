# No environment variables are required for local development or tests.

# Optional: set the canonical site origin for metadata/sitemap/RSS.
# Must be a valid http/https origin with no credentials or path.
# Defaults to https://kafka-hub.dev when unset.
# NEXT_PUBLIC_SITE_URL=https://kafka-hub.dev

# Optional: enable LLM-augmented diagnostics.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: enable anonymous Plausible page-view analytics.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

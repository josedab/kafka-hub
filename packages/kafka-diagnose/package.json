{
  "name": "@kafka-hub/kafka-diagnose",
  "version": "0.1.0",
  "description": "Deterministic static rule engine for Kafka broker, topic, producer, and consumer .properties files.",
  "license": "MIT",
  "author": "Jose David Baena <josedab@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.10"
  },
  "keywords": [
    "kafka",
    "diagnostics",
    "config",
    "linter",
    "properties"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/kafka-hub.git",
    "directory": "packages/kafka-diagnose"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

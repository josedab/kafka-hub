{
  "name": "kafka-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "fumadocs-mdx",
    "dev": "next dev",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start": "pnpm prepare:standalone && node .next/standalone/server.js",
    "check:production-env": "node scripts/check-production-env.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location .eslintcache",
    "test": "pnpm test:unit && pnpm --filter @kafka-hub/kafka-diagnose test && pnpm --filter @kafka-hub/kafka-sim test && pnpm --filter @kafka-hub/kafka-cli test && pnpm --filter @kafka-hub/kafka-planners test && pnpm --filter @kafka-hub/incident-parser test",
    "test:unit": "tsx --test lib/*.test.ts app/api/diagnose/llm/route.test.ts app/api/health/route.test.ts scripts/check-production-env.test.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "postinstall": "fumadocs-mdx",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@kafka-hub/incident-parser": "workspace:*",
    "@kafka-hub/kafka-diagnose": "workspace:*",
    "@kafka-hub/kafka-planners": "workspace:*",
    "@kafka-hub/kafka-sim": "workspace:*",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.13.0",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.13.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typescript": "^5"
  }
}

# No variables are required for local development or tests.

# Build-time public values. NEXT_PUBLIC_SITE_URL is required for a real
# production deploy and must be an HTTPS origin without credentials, path,
# query, or fragment. A root trailing slash is accepted.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional anonymous Plausible page views. Use the configured site domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com

# Optional runtime LLM boundary. Set both or neither; there is no default model.
# Never prefix secrets with NEXT_PUBLIC_ or pass them as Docker build args.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Optional runtime proxy trust. Leave false unless a trusted reverse proxy
# removes client forwarding headers and writes authoritative values.
TRUST_PROXY_HEADERS=false

# Optional self-hosted health metadata. Vercel supplies
# VERCEL_GIT_COMMIT_SHA automatically; GIT_SHA must be hexadecimal.
# GIT_SHA=

# Standalone/container runtime defaults.
HOSTNAME=0.0.0.0
PORT=3000
NEXT_TELEMETRY_DISABLED=1
